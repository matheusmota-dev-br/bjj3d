{
  "name": "bjj3d",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @bjj3d/web dev",
    "build": "pnpm --filter @bjj3d/web build",
    "preview": "pnpm --filter @bjj3d/web preview",
    "data": "pnpm --filter @bjj3d/data build-graph",
    "validate": "pnpm --filter @bjj3d/data validate",
    "find": "pnpm --filter @bjj3d/data find",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @bjj3d/web e2e",
    "storybook": "pnpm --filter @bjj3d/storybook dev",
    "build-storybook": "pnpm --filter @bjj3d/storybook build",
    "character": "node tools/character.mjs",
    "gi-plan": "node tools/gi-plan.mjs",
    "screens": "node tools/screens.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.181.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-istanbul": "^4.1.12",
    "playwright": "^1.64.1",
    "three": "^0.181.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
