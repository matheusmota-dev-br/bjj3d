{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matheusmota-dev-br/bjj3d/schemas/text/v1",
  "title": "Text",
  "description": "A text in several languages, keyed by language tag (en, pt-BR, …). English is always there.",
  "type": "object",
  "required": ["en"],
  "properties": { "en": { "type": "string", "minLength": 1 } },
  "additionalProperties": { "type": "string" }
}
