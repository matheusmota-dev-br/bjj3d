{
  "name": "@bjj3d/data",
  "version": "0.0.0",
  "private": true,
  "description": "The database as the viewer loads it (graph.json), and the scripts that build and check it.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "build-graph": "node scripts/build-data.ts",
    "validate": "node scripts/validate.ts",
    "calibrate": "node scripts/calibrate.ts",
    "find": "node scripts/find.ts"
  },
  "dependencies": {
    "@bjj3d/core": "workspace:*",
    "@bjj3d/grapplemap": "workspace:*",
    "@bjj3d/metrics": "workspace:*"
  },
  "files": [
    "src",
    "schemas",
    "scripts"
  ]
}
